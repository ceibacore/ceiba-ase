# ASE - Agnostic Subscription Engine
# Copy to .env and configure for your environment

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=lemur_ase
DB_USERNAME=root
DB_PASSWORD=
DB_PREFIX=ase_

# Security
ASE_SECRET_KEY=dev-secret-key-change-in-production

# Payment Gateways (optional at setup time)
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
