# ASE - Agnostic Subscription Engine
# Copy to .env and configure for your environment

# Database Configuration
ASE_DB_HOST=localhost
ASE_DB_PORT=3306
ASE_DB_NAME=lemur_ase
ASE_DB_USER=root
ASE_DB_PASS=
ASE_DB_PREFIX=ase_

# Security
ASE_SECRET_KEY=dev-secret-key-change-in-production

# Payment Gateways (optional at setup time)
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
