# ASE - Agnostic Subscription Engine
# Copy to .env and configure for your environment

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=lemur_ase
DB_USERNAME=root
DB_PASSWORD=
DB_PREFIX=ase_

# Payment Gateways (optional at setup time)
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# Gateway Form — Credential Encryption
# Generate key: php -r "echo base64_encode(random_bytes(32));"
# REQUIRED in production — omitting stores credentials as plaintext JSON
GATEWAY_ENCRYPTION_KEY=

# Gateway Form — CSRF Secret (falls back to GATEWAY_SERVICE_SECRET if not set)
# Generate: php -r "echo base64_encode(random_bytes(32));"
GATEWAY_CSRF_SECRET=

# Security
GATEWAY_SERVICE_SECRET=dev-secret-key-change-in-production
